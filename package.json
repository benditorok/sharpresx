{
  "name": "netresx",
  "displayName": "netresx",
  "description": "dotnet .resx editor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "netresx.openTranslationGrid",
        "title": "Open Translation Grid",
        "category": "RESX",
        "icon": "$(table)"
      },
      {
        "command": "netresx.createResourceFiles",
        "title": "Create RESX Files",
        "category": "RESX"
      },
      {
        "command": "netresx.configureDesigner",
        "title": "Configure Designer Generation",
        "category": "RESX"
      },
      {
        "command": "netresx.saveGrid",
        "title": "Save Resource Grid",
        "category": "RESX"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "netresx.openTranslationGrid",
          "when": "resourceExtname == .resx && isFileSystemResource",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "netresx.openTranslationGrid",
          "when": "resourceExtname == .resx && isFileSystemResource"
        },
        {
          "command": "netresx.createResourceFiles",
          "when": "resourceExtname == .resx && isFileSystemResource"
        },
        {
          "command": "netresx.configureDesigner",
          "when": "resourceExtname == .resx && isFileSystemResource"
        },
        {
          "command": "netresx.saveGrid",
          "when": "activeWebviewPanelId == netresx.translationGrid"
        }
      ],
      "explorer/context": [
        {
          "command": "netresx.createResourceFiles",
          "when": "isFileSystemResource && (explorerResourceIsFolder || resourceExtname == .resx)",
          "group": "2_workspace"
        },
        {
          "command": "netresx.configureDesigner",
          "when": "resourceExtname == .resx && isFileSystemResource",
          "group": "2_workspace"
        }
      ]
    },
    "keybindings": [
      {
        "command": "netresx.saveGrid",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == netresx.translationGrid"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  }
}
