{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": ["watch:tsc", "watch:esbuild"],
			"group": { "kind": "build", "isDefault": true }
		},
		{
			"label": "watch:esbuild",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "watch:esbuild"],
			"isBackground": true,
			"group": "build",
			"problemMatcher": {
				"owner": "esbuild",
				"severity": "error",
				"fileLocation": ["autodetect", "${workspaceFolder}"],
				"pattern": [
					{ "regexp": "^✘ \\[ERROR\\] (.+)$", "message": 1 },
					{ "regexp": "^\\s+(.+):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\] build started$",
					"endsPattern": "^\\[watch\\] build finished$"
				}
			},
			"presentation": { "group": "watch", "reveal": "never" }
		},
		{
			"label": "watch:tsc",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "watch:tsc"],
			"isBackground": true,
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"presentation": { "group": "watch", "reveal": "never" }
		},
		{
			"label": "watch-tests",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "watch-tests"],
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"presentation": { "group": "watch", "reveal": "never" }
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": ["watch", "watch-tests"],
			"problemMatcher": []
		}
	]
}
